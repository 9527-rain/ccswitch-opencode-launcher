#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-}" in
  update)
    if [ "${2:-}" = "--version" ] || [ "${2:-}" = "-v" ]; then
      [ -n "${3:-}" ] || { echo "update --version requires vX.Y.Z" >&2; exit 2; }
      exec env OPENCODE_CCSWITCH_INSTALL_DIR="$SCRIPT_DIR" sh "$SCRIPT_DIR/install.sh" --version "$3"
    fi
    [ "$#" -eq 1 ] || { echo "update usage: update [--version vX.Y.Z]" >&2; exit 2; }
    exec env OPENCODE_CCSWITCH_INSTALL_DIR="$SCRIPT_DIR" sh "$SCRIPT_DIR/install.sh" --latest
    ;;
  uninstall)
    exec env OPENCODE_CCSWITCH_INSTALL_DIR="$SCRIPT_DIR" sh "$SCRIPT_DIR/install.sh" --uninstall
    ;;
esac
if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "Python 3 is required" >&2
  exit 1
fi
exec "$PYTHON" "$SCRIPT_DIR/opencode-ccswitch.py" "$@"
